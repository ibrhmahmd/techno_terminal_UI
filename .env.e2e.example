# Copy to .env.e2e (gitignored) and fill in. Staging only: the suite refuses any other host.
E2E_API_TARGET=https://techno-terminal-staging.fastapicloud.dev

# Dedicated staging test accounts.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_SYSTEM_ADMIN_EMAIL=
E2E_SYSTEM_ADMIN_PASSWORD=
E2E_INSTRUCTOR_A_EMAIL=
E2E_INSTRUCTOR_A_PASSWORD=
E2E_INSTRUCTOR_B_EMAIL=
E2E_INSTRUCTOR_B_PASSWORD=

# Employee full names of the two instructor accounts, exactly as shown in instructor pickers.
E2E_INSTRUCTOR_A_NAME=
E2E_INSTRUCTOR_B_NAME=
